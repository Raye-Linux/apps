msgctxt "@action:button while it works"
msgid "Applying…"
msgstr "Application…"

msgctxt "@action:button"
msgid "Apply"
msgstr "Appliquer"

msgctxt "@action:button"
msgid "Discard changes"
msgstr "Annuler les modifications"

msgctxt "@action:button"
msgid "Restore defaults"
msgstr "Rétablir les valeurs par défaut"

msgctxt "@info:tooltip a point of the fan curve"
msgid "%1 °C, fan at %2%"
msgstr "%1 °C, ventilateur à %2 %"

msgctxt "@title"
msgid "Fan"
msgstr "Ventilateur"

msgctxt "@info"
msgid "This card drives its fan itself and doesn't let it be changed."
msgstr "Cette carte gère elle-même son ventilateur et ne permet pas de le modifier."

msgctxt "@info"
msgid "This graphics card has no fan of its own: it is cooled with the rest of the PC."
msgstr "Cette carte graphique n’a pas de ventilateur à elle : elle est refroidie avec le reste du PC."

msgctxt "@label"
msgid "Fan control"
msgstr "Contrôle du ventilateur"

msgctxt "@info"
msgid "The fan follows the curve below."
msgstr "Le ventilateur suit la courbe ci-dessous."

msgctxt "@info"
msgid "The card speeds its fan up and down by itself."
msgstr "La carte accélère et ralentit son ventilateur d’elle-même."

msgctxt "@item fan control"
msgid "Automatic"
msgstr "Automatique"

msgctxt "@item fan control"
msgid "Custom curve"
msgstr "Courbe personnalisée"

msgctxt "@label"
msgid "Fan speed by hotspot temperature"
msgstr "Vitesse du ventilateur selon le point chaud"

msgctxt "@label"
msgid "Fan speed by temperature"
msgstr "Vitesse du ventilateur selon la température"

msgctxt "@info temperature and fan speed now"
msgid "Now %1, fan at %2"
msgstr "Maintenant %1, ventilateur à %2"

msgctxt "@info temperature now"
msgid "Now %1"
msgstr "Maintenant %1"

msgctxt "@info"
msgid "The card follows this curve itself. Drag a point, or click it and use the arrow keys."
msgstr "La carte suit elle-même cette courbe. Faites glisser un point, ou cliquez dessus et utilisez les flèches."

msgctxt "@info"
msgid "Above %1 the fan always runs at full speed. Drag a point, or click it and use the arrow keys."
msgstr "Au-dessus de %1, le ventilateur tourne toujours à fond. Faites glisser un point, ou cliquez dessus et utilisez les flèches."

msgctxt "@action:button"
msgid "Reset curve"
msgstr "Réinitialiser la courbe"

msgctxt "@info memory size in gibibytes"
msgid "%1 GB"
msgstr "%1 Go"

msgctxt "@info memory size in mebibytes"
msgid "%1 MB"
msgstr "%1 Mo"

msgctxt "@info a share, as a percentage"
msgid "%1%"
msgstr "%1 %"

msgctxt "@info a clock speed"
msgid "%1 MHz"
msgstr "%1 MHz"

msgctxt "@info a temperature"
msgid "%1 °C"
msgstr "%1 °C"

msgctxt "@info a power"
msgid "%1 W"
msgstr "%1 W"

msgctxt "@info a fan speed in turns a minute"
msgid "%1 RPM"
msgstr "%1 tr/min"

