msgid "Import"
msgstr "Importer"

msgid "Nothing in this file can be imported here."
msgstr "Rien dans ce fichier ne peut être importé ici."

msgid "One value will be changed. A copy of each file is kept first."
msgid_plural "%1 values will be changed. A copy of each file is kept first."
msgstr[0] "Une valeur va être modifiée. Une copie de chaque fichier est gardée avant."
msgstr[1] "%1 valeurs vont être modifiées. Une copie de chaque fichier est gardée avant."

msgid "One value is skipped: its key is not here, or cannot be changed."
msgid_plural "%1 values are skipped: their key is not here, or cannot be changed."
msgstr[0] "Une valeur est ignorée : sa clé n’est pas ici, ou ne peut pas être modifiée."
msgstr[1] "%1 valeurs sont ignorées : leur clé n’est pas ici, ou ne peut pas être modifiée."

msgctxt "@title:window"
msgid "Registry Editor"
msgstr "Éditeur du Registre"

msgid "Version %1"
msgstr "Version %1"

msgid "Shows the settings of your apps and of the system as one tree, and changes them the careful way: only the value's line changes, a copy of the file is kept first, and Ctrl+Z takes a change back."
msgstr "Montre les paramètres de vos applications et du système dans un seul arbre, et les modifie avec soin : seule la ligne de la valeur change, une copie du fichier est gardée avant, et Ctrl+Z annule une modification."

msgctxt "@title:window"
msgid "Export registry file"
msgstr "Exporter un fichier de Registre"

msgctxt "@item file type"
msgid "Registry files (*.rayereg)"
msgstr "Fichiers de Registre (*.rayereg)"

msgctxt "@title:window"
msgid "Import registry file"
msgstr "Importer un fichier de Registre"

msgctxt "@action:button"
msgid "Cancel"
msgstr "Annuler"

msgctxt "@item value type"
msgid "Number"
msgstr "Nombre"

msgctxt "@item value type"
msgid "Yes/No"
msgstr "Oui/Non"

msgctxt "@item value type"
msgid "List"
msgstr "Liste"

msgctxt "@item value type"
msgid "Text"
msgstr "Texte"

msgctxt "@item value type"
msgid "Decimal number"
msgstr "Nombre décimal"

msgctxt "@item value type"
msgid "List of text"
msgstr "Liste de textes"

msgctxt "@item value type, %1 is a GVariant type such as (ii)"
msgid "Value (%1)"
msgstr "Valeur (%1)"

msgid "This value must be of the type %1."
msgstr "Cette valeur doit être du type %1."

msgid "Type a whole number."
msgstr "Tapez un nombre entier."

msgid "Type yes or no."
msgstr "Tapez yes ou no."

msgid "This value must stay on one line."
msgstr "Cette valeur doit tenir sur une seule ligne."

msgid "There is already a value named %1."
msgstr "Une valeur s’appelle déjà %1."

msgid "Open a folder first, then add the value there."
msgstr "Ouvrez d’abord un dossier, puis ajoutez-y la valeur."

msgid "This is not a valid value: %1"
msgstr "Cette valeur n’est pas valide : %1"

msgid "The key %1 is no longer there."
msgstr "La clé %1 n’existe plus."

msgid "The change was not allowed."
msgstr "La modification n’a pas été autorisée."

msgid "The value could not be changed."
msgstr "La valeur n’a pas pu être modifiée."

msgid "The file could not be saved: %1"
msgstr "Le fichier n’a pas pu être enregistré : %1"

msgid "Exported one key."
msgid_plural "Exported %1 keys."
msgstr[0] "Une clé exportée."
msgstr[1] "%1 clés exportées."

msgid "The file could not be opened."
msgstr "Le fichier n’a pas pu être ouvert."

msgid "This is not a file the Registry Editor made (line %1)."
msgstr "Ce fichier ne vient pas de l’Éditeur du Registre (ligne %1)."

msgid "Imported one value."
msgid_plural "Imported %1 values."
msgstr[0] "Une valeur importée."
msgstr[1] "%1 valeurs importées."

msgctxt "@item the top of the registry tree"
msgid "Computer"
msgstr "Ordinateur"

msgid "Read only: this file comes with the %1 package, and an edit here would stop updates from changing it."
msgstr "Lecture seule : ce fichier vient du paquet %1, et le modifier ici empêcherait les mises à jour de le changer."

msgid "%1 can't be changed in Registry Editor: a program running as root would load what it names."
msgstr "%1 ne peut pas être modifié dans l’Éditeur du Registre : un programme exécuté en tant que root chargerait ce qu’il désigne."

msgid "This file comes with a package and is read only here."
msgstr "Ce fichier vient d’un paquet et il est en lecture seule ici."

msgid "This file can't be changed in Registry Editor."
msgstr "Ce fichier ne peut pas être modifié dans l’Éditeur du Registre."

msgid "%1 could not be changed."
msgstr "%1 n’a pas pu être modifié."
